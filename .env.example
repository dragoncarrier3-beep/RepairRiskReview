# =============================================================================
# Repair Risk Review — Environment variables
# Copy to .env.local for local development.
# In Netlify: Site settings → Environment variables → Import from .env
# =============================================================================

# App
NODE_VERSION=20
NEXT_TELEMETRY_DISABLED=1

# Public (safe for browser)
NEXT_PUBLIC_APP_NAME=Repair Risk Review
NEXT_PUBLIC_BRAND_NAME=My Road Armor
NEXT_PUBLIC_DEMO_VIN=3GNAXUEV3L6123456
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin demo credentials are seeded into data/db.json
# Email: admin@repairriskreview.com
# Password: Demo123!
SEED_ADMIN_EMAIL=admin@repairriskreview.com

# Optional: override after deploy (set in Netlify UI)
# NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
